# ============================================================
# SydneyGo – API Backend Environment Variables
# Copy this file to .env and fill in your real values.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:19006,exp://localhost:8081

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Places
GOOGLE_PLACES_API_KEY=

# Mapbox
MAPBOX_ACCESS_TOKEN=

# Transport NSW
TRANSPORT_NSW_API_KEY=
TRANSPORT_NSW_BASE_URL=https://api.transport.nsw.gov.au/v2

# Yelp Fusion
YELP_API_KEY=
YELP_BASE_URL=https://api.yelp.com/v3

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/sydneygo

# Redis (session / caching)
REDIS_URL=redis://localhost:6379

# Sentry
SENTRY_DSN=
