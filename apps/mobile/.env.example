# ============================================================
# SydneyGo – Mobile App Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Backend API ---
API_BASE_URL=https://api.sydneygo.com/v1

# --- Google Maps / Places ---
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- OpenAI (AI Chat & Onboarding) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Three.js / Mapbox 3D ---
MAPBOX_ACCESS_TOKEN=

# --- Transport NSW Open Data ---
TRANSPORT_NSW_API_KEY=
TRANSPORT_NSW_BASE_URL=https://api.transport.nsw.gov.au/v2

# --- Yelp Fusion (Restaurants) ---
YELP_API_KEY=
YELP_BASE_URL=https://api.yelp.com/v3

# --- Firebase (Auth & Analytics) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Sentry (Error Tracking) ---
SENTRY_DSN=
